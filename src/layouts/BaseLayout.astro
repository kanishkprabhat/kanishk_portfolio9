---
interface Props {
  title?: string;
}

const {title = "Kanishk Prabhat | Digital Marketer"} = Astro.props;
const description = "Kanishk Prabhat is a digital marketer in Noida, India, specializing in Google Ads, Meta Ads, SEO, and performance marketing.";
const keywords = [
  "Kanishk Prabhat",
  "Kanishk Prabhat portfolio",
  "digital marketer Noida",
  "Google Ads Specialist",
  "Meta Ads Specialist",
  "SEO Specialist Noida",
  "Noida digital marketer",
  "India digital marketer",
  "PRPilot",
  "Auctus",
  "D3Careers",
  "BSI Solutionz",
  "EVLOS-OPS",
  "Likit",
  "React",
  "Astro",
  "Next.js",
  "TypeScript",
  "JavaScript",
  "Java",
  "Node.js",
  "Express",
  "Spring Boot",
  "D3.js",
  "Tailwind CSS",
  "GSAP",
  "MongoDB",
  "PostgreSQL",
  "Supabase",
  "DynamoDB",
  "AWS Lambda",
  "API Gateway",
  "SQS",
  "Docker",
  "GitHub Actions",
  "ArcGIS",
  "GIS developer",
].join(", ");
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="Kanishk Prabhat" />
        <meta name="robots" content="index, follow" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Kanishk Prabhat Portfolio" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <link rel="icon" href="/favicon.ico" type="image/x-icon" />
        <title>{title}</title>                                                                                                                                                    
    </head>                                                                                                                                                                     
    <body>                                                                                                                                                                      
        <slot />                                                                                                                                                                  
    </body>       
</html>                                                                                                                                                                       
                  
<style is:global>
    @import '../styles/global.css';
</style>     
