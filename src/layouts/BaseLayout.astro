---
interface Props {
  title?: string;
}

const {title = "Kanishk Prabhat | Digital Marketer"} = Astro.props;
const description = "Kanishk Prabhat is a digital marketer and performance marketer based in New Delhi / Noida, India, specializing in Google Ads, Meta Ads, lead generation, GA4, and performance analytics.";
const keywords = [
  "Kanishk Prabhat",
  "Kanishk Prabhat portfolio",
  "Kanishk Prabhat resume",
  "Digital Marketer",
  "Performance Marketer",
  "Performance Marketing",
  "Google Ads Specialist",
  "Meta Ads Specialist",
  "Lead Generation",
  "Audience Targeting",
  "Campaign Optimization",
  "GA4",
  "Google Tag Manager",
  "Conversion Tracking",
  "SEO",
  "Marketing Automation",
  "Digital Marketer Delhi NCR",
  "Digital Marketer Noida",
  "Dwell Construction Meta Ads",
  "JSN Silicon Valley Meta Ads",
  "ThePetNest Google Ads"
].join(", ");
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="Kanishk Prabhat" />
        <meta name="robots" content="index, follow" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Kanishk Prabhat Portfolio" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <link rel="icon" href="/favicon.ico" type="image/x-icon" />
        <title>{title}</title>                                                                                                                                                    
    </head>                                                                                                                                                                     
    <body>                                                                                                                                                                      
        <slot />                                                                                                                                                                  
    </body>       
</html>                                                                                                                                                                       
                  
<style is:global>
    @import '../styles/global.css';
</style>     
